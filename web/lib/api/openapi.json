          },
          {
            "in": "query",
            "name": "religious_orientation",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Religious Orientation"
            }
          }
        ],
