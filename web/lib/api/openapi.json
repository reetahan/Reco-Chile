    "/geocode": {
      "post": {
        "description": "Resolve a family-entered address, behind a per-IP budget.\n\nThe address is never stored; only the coordinates travel back. Nominatim's\n1 req/s policy is enforced inside geo.py for the whole process, so the\nlimit here exists to stop one caller from consuming that shared budget.",
        "operationId": "geocode_geocode_post",
        "parameters": [
          {
            "description": "Language for `message` fields: es (default) or en.",
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Language for `message` fields: es (default) or en.",
              "title": "Lang"
            }
          },
          {
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Accept-Language"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeocodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Geocode"
      }
    },
