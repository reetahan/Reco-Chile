# Base URL of the FastAPI backend (api.py). The browser never talks to it
# directly: `web/app/api/[...path]/route.ts` proxies to it server-side, so this
# value stays on the server and the Python port need not be public.
API_BASE_URL=http://localhost:8000

# Next.js collects anonymous usage telemetry by default. This app ships no
# analytics — export this in your shell / CI to opt out:
#   NEXT_TELEMETRY_DISABLED=1

# Trust the X-Forwarded-For header of the hop in front of this Next.js process.
# The proxy in `app/api/[...path]/route.ts` uses the rightmost entry as the
# caller's address so FastAPI's per-IP geocoding budget is per browser instead
# of per proxy. Set to 1 ONLY when a reverse proxy you control (nginx, a load
# balancer, Vercel) always rewrites that header. With Next.js exposed directly,
# the header is client input: honouring it would let one caller mint a fresh
# rate-limit bucket per request, so unset every caller shares one bucket.
#   TRUST_PROXY=1

# Origins allowed to call the FastAPI service (api.py) cross-origin, comma
# separated — read by the Python process, not by Next.js. Leave unset for the
# deployment above: the browser only talks to this Next.js origin, so FastAPI
# needs no CORS middleware at all. Never set it to *.
#   SAE_CORS_ORIGINS=https://sae.example.cl
